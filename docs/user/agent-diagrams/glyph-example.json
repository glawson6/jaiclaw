    {"type": "glyph", "params": {"x": 3,  "y": 6, "name": "fail"}},
    {"type": "label", "params": {"text": "queue       offline","x": 6, "y": 6}},

    {"type": "glyph", "params": {"x": 3,  "y": 7, "name": "pending"}},
